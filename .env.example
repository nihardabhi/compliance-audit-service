# Server
PORT=3000
NODE_ENV=development

# Auth — in production these come from a secrets manager (AWS Secrets Manager / SSM).
# The signing secret is used to mint and verify JWTs.
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_ISSUER=compliance-audit-service
JWT_AUDIENCE=medlaunch-clients
JWT_EXPIRES_IN=3600

# Secret used to sign expiring attachment download tokens (HMAC).
DOWNLOAD_TOKEN_SECRET=dev-only-download-secret-change-me
DOWNLOAD_TOKEN_TTL_SECONDS=300

# File storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Logging
LOG_LEVEL=info