# Server
PORT=3000
NODE_ENV=development

# Auth — in production these come from a secrets manager (AWS Secrets Manager / SSM).
# The signing secret is used to mint and verify JWTs.
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_ISSUER=compliance-audit-service
JWT_AUDIENCE=medlaunch-clients
JWT_EXPIRES_IN=3600

# Secret used to sign expiring attachment download tokens (HMAC).
DOWNLOAD_TOKEN_SECRET=dev-only-download-secret-change-me
DOWNLOAD_TOKEN_TTL_SECONDS=300

# File storage — set STORAGE_DRIVER=s3 to use S3 instead of local disk
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# S3 storage (only needed when STORAGE_DRIVER=s3)
# S3_BUCKET=compliance-audit-files
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:4566
# AWS_ACCESS_KEY_ID=AKIAWJIAAUTBFVHBKR4Y
# AWS_SECRET_ACCESS_KEY=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

# MongoDB (optional — omit to use in-memory store)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=compliance-audit

# Logging
LOG_LEVEL=info